{
  "__comment": "Bespoke Lumenwilds terrain (Phase 5a). Default block = moonstone; rolling hills/cliffs from a y-gradient + multi-octave 'hills' noise centred ~y88, with shallow water in the low spots. Surface rules layer lumen grass -> moonloam -> moonstone, with deep moonstone below ~y0. Climate/aquifer/vein router inputs are 0 (single biome for now); dramatic vertical landforms (root bridges, crags, caverns) come via features/biomes in later 5x passes.",
  "aquifers_enabled": false,
  "default_block": { "Name": "lumenwilds:moonstone" },
  "default_fluid": { "Name": "minecraft:water", "Properties": { "level": "0" } },
  "disable_mob_generation": false,
  "legacy_random_source": false,
  "ore_veins_enabled": false,
  "sea_level": 63,
  "spawn_target": [],
  "noise": {
    "min_y": -64,
    "height": 384,
    "size_horizontal": 1,
    "size_vertical": 2
  },
  "noise_router": {
    "barrier": 0.0,
    "fluid_level_floodedness": 0.0,
    "fluid_level_spread": 0.0,
    "lava": 0.0,
    "temperature": 0.0,
    "vegetation": 0.0,
    "continents": 0.0,
    "erosion": 0.0,
    "depth": {
      "__comment": "y-varying depth so the MultiNoise biome source can layer the Undercrown Caverns cave biome UNDER the surface biomes (Phase 5d.5). ~0 at/above the surface (y88, surface biomes win), rising to 1 deep (y-40, the deep-depth Undercrown point wins). This is the ONLY climate axis that varies; the surface biomes all sit at depth 0 so their distribution is unchanged.",
      "type": "minecraft:y_clamped_gradient",
      "from_y": 88,
      "to_y": -40,
      "from_value": 0.0,
      "to_value": 1.0
    },
    "ridges": 0.0,
    "vein_toggle": 0.0,
    "vein_ridged": 0.0,
    "vein_gap": 0.0,
    "initial_density_without_jaggedness": {
      "type": "minecraft:add",
      "argument1": {
        "type": "minecraft:y_clamped_gradient",
        "from_y": 40,
        "to_y": 136,
        "from_value": 1.5,
        "to_value": -1.5
      },
      "argument2": {
        "type": "minecraft:mul",
        "argument1": 0.8,
        "argument2": {
          "type": "minecraft:noise",
          "noise": "lumenwilds:hills",
          "xz_scale": 1.0,
          "y_scale": 0.0
        }
      }
    },
    "final_density": {
      "type": "minecraft:squeeze",
      "argument": {
        "type": "minecraft:mul",
        "argument1": 0.64,
        "argument2": {
          "type": "minecraft:interpolated",
          "argument": {
            "type": "minecraft:blend_density",
            "argument": {
              "type": "minecraft:add",
              "argument1": {
                "type": "minecraft:y_clamped_gradient",
                "from_y": 40,
                "to_y": 136,
                "from_value": 1.5,
                "to_value": -1.5
              },
              "argument2": {
                "type": "minecraft:mul",
                "argument1": 0.8,
                "argument2": {
                  "type": "minecraft:noise",
                  "noise": "lumenwilds:hills",
                  "xz_scale": 1.0,
                  "y_scale": 0.0
                }
              }
            }
          }
        }
      }
    }
  },
  "surface_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": { "type": "minecraft:above_preliminary_surface" },
        "then_run": {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:stone_depth",
            "offset": 0,
            "surface_type": "floor",
            "add_surface_depth": false,
            "secondary_depth_range": 0
          },
          "then_run": {
            "type": "minecraft:sequence",
            "sequence": [
              {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "minecraft:water",
                  "offset": -1,
                  "surface_depth_multiplier": 0,
                  "add_stone_depth": false
                },
                "then_run": { "type": "minecraft:block", "result_state": { "Name": "lumenwilds:lumen_grass_block" } }
              },
              { "type": "minecraft:block", "result_state": { "Name": "lumenwilds:moonloam" } }
            ]
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": { "type": "minecraft:above_preliminary_surface" },
        "then_run": {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:stone_depth",
            "offset": 3,
            "surface_type": "floor",
            "add_surface_depth": false,
            "secondary_depth_range": 0
          },
          "then_run": { "type": "minecraft:block", "result_state": { "Name": "lumenwilds:moonloam" } }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:vertical_gradient",
          "random_name": "lumenwilds:deep_moonstone",
          "true_at_and_below": { "absolute": -16 },
          "false_at_and_above": { "absolute": 0 }
        },
        "then_run": { "type": "minecraft:block", "result_state": { "Name": "lumenwilds:deep_moonstone" } }
      }
    ]
  }
}
