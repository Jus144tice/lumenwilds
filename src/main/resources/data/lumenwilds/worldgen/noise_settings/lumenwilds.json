{
  "__comment": "Bespoke Lumenwilds terrain. Default block = moonstone; default fluid = glowing Lumenwater (light 4, safe: aquifers off). Alien cliffy relief (Phase 9 drawing-board, see __terrain_comment) with deep Lumenwater seas in the basins, and depth-gated noise CAVES hollowing the deep (the Undercrown). Surface rules layer lumen grass -> moonloam -> moonstone, deep moonstone below ~y0. Climate router: temperature+vegetation are real shifted-noise (7-biome spread); depth is y-varying (cave biome under the surface).",
  "aquifers_enabled": true,
  "default_block": { "Name": "lumenwilds:moonstone" },
  "default_fluid": { "Name": "lumenwilds:lumenwater", "Properties": { "level": "0" } },
  "disable_mob_generation": false,
  "legacy_random_source": false,
  "ore_veins_enabled": false,
  "sea_level": 63,
  "spawn_target": [],
  "noise": {
    "min_y": -64,
    "height": 384,
    "size_horizontal": 1,
    "size_vertical": 2
  },
  "noise_router": {
    "__aquifer_comment": "Aquifers ON (Phase 9 drawing-board) so the deep noise caves are AIR caverns with Lumenwater POOLS at the local water table (the bible's Undercrown) instead of fully flooding below sea level. Water-only: the lava router is a POSITIVE constant (1.0) — measured inverted, a negative value paradoxically MAKES more lava (-1 -> 751, -10 -> 3396 deep lava blocks; +1 -> ~0). Vanilla-style barrier/floodedness/spread noises control where pools sit.",
    "barrier": { "type": "minecraft:noise", "noise": "minecraft:aquifer_barrier", "xz_scale": 1.0, "y_scale": 0.5 },
    "fluid_level_floodedness": {
      "type": "minecraft:noise",
      "noise": "minecraft:aquifer_fluid_level_floodedness",
      "xz_scale": 1.0,
      "y_scale": 0.67
    },
    "fluid_level_spread": {
      "type": "minecraft:noise",
      "noise": "minecraft:aquifer_fluid_level_spread",
      "xz_scale": 1.0,
      "y_scale": 0.7142857142857143
    },
    "lava": 0.0,
    "temperature": {
      "__comment": "Real varying climate so the MultiNoise biome source spreads all 7 biomes (was a 0.0 constant -> one biome). Shifted noise at biome scale.",
      "type": "minecraft:shifted_noise",
      "noise": "minecraft:temperature",
      "shift_x": "minecraft:shift_x",
      "shift_y": 0.0,
      "shift_z": "minecraft:shift_z",
      "xz_scale": 0.25,
      "y_scale": 0.0
    },
    "vegetation": {
      "__comment": "Humidity axis — drives the humid/dry biome split (Glade vs Forest, Moonmire, Basin).",
      "type": "minecraft:shifted_noise",
      "noise": "minecraft:vegetation",
      "shift_x": "minecraft:shift_x",
      "shift_y": 0.0,
      "shift_z": "minecraft:shift_z",
      "xz_scale": 0.25,
      "y_scale": 0.0
    },
    "continents": 0.0,
    "erosion": 0.0,
    "depth": {
      "__comment": "y-varying depth so the MultiNoise biome source layers the Undercrown Caverns cave biome UNDER the surface biomes. ~0 at/above the surface, rising to 1 deep (the deep-depth Undercrown point wins).",
      "type": "minecraft:y_clamped_gradient",
      "from_y": 88,
      "to_y": -40,
      "from_value": 0.0,
      "to_value": 1.0
    },
    "ridges": 0.0,
    "vein_toggle": 0.0,
    "vein_ridged": 0.0,
    "vein_gap": 0.0,
    "__terrain_comment": "base = a gentle y-gradient (zero ~y70, just above sea 63 so basins reach water) + three 'hills' octaves: BIG (xz 0.35) regional plateaus/basins, MID (xz 1.0, main local relief), SHARP (xz 2.2) rugged cliff faces -> surface swings ~y25..170 (deep Lumenwater seas in basins, high cliffs on rises). CAVES: a depth-gated carve is folded INTO the interpolated base (vanilla sloped-cheese style — adding it OUTSIDE the squeeze/interpolated tree does NOT carve): below ~y45 the 'caverns' 3D noise (period ~32) subtracts density where open, hollowing real caverns through the deep (the Undercrown). final = squeeze(0.64 * interpolated(blend_density(base + caveCarve))).",
    "initial_density_without_jaggedness": {
      "type": "minecraft:add",
      "argument1": {
        "type": "minecraft:y_clamped_gradient",
        "from_y": 10,
        "to_y": 130,
        "from_value": 1.6,
        "to_value": -1.6
      },
      "argument2": {
        "type": "minecraft:add",
        "argument1": {
          "type": "minecraft:mul",
          "argument1": 0.9,
          "argument2": { "type": "minecraft:noise", "noise": "lumenwilds:hills", "xz_scale": 0.35, "y_scale": 0.0 }
        },
        "argument2": {
          "type": "minecraft:add",
          "argument1": {
            "type": "minecraft:mul",
            "argument1": 1.0,
            "argument2": { "type": "minecraft:noise", "noise": "lumenwilds:hills", "xz_scale": 1.0, "y_scale": 0.0 }
          },
          "argument2": {
            "type": "minecraft:mul",
            "argument1": 0.5,
            "argument2": { "type": "minecraft:noise", "noise": "lumenwilds:hills", "xz_scale": 2.2, "y_scale": 0.0 }
          }
        }
      }
    },
    "final_density": {
      "type": "minecraft:squeeze",
      "argument": {
        "type": "minecraft:mul",
        "argument1": 0.64,
        "argument2": {
          "type": "minecraft:interpolated",
          "argument": {
            "type": "minecraft:blend_density",
            "argument": {
              "type": "minecraft:add",
              "argument1": {
                "type": "minecraft:add",
                "argument1": {
                  "type": "minecraft:y_clamped_gradient",
                  "from_y": 10,
                  "to_y": 130,
                  "from_value": 1.6,
                  "to_value": -1.6
                },
                "argument2": {
                  "type": "minecraft:add",
                  "argument1": {
                    "type": "minecraft:mul",
                    "argument1": 0.9,
                    "argument2": { "type": "minecraft:noise", "noise": "lumenwilds:hills", "xz_scale": 0.35, "y_scale": 0.0 }
                  },
                  "argument2": {
                    "type": "minecraft:add",
                    "argument1": {
                      "type": "minecraft:mul",
                      "argument1": 1.0,
                      "argument2": { "type": "minecraft:noise", "noise": "lumenwilds:hills", "xz_scale": 1.0, "y_scale": 0.0 }
                    },
                    "argument2": {
                      "type": "minecraft:mul",
                      "argument1": 0.5,
                      "argument2": { "type": "minecraft:noise", "noise": "lumenwilds:hills", "xz_scale": 2.2, "y_scale": 0.0 }
                    }
                  }
                }
              },
              "argument2": {
                "type": "minecraft:mul",
                "argument1": {
                  "type": "minecraft:y_clamped_gradient",
                  "from_y": 52,
                  "to_y": -5,
                  "from_value": 0.0,
                  "to_value": 1.0
                },
                "argument2": {
                  "type": "minecraft:mul",
                  "argument1": -8.5,
                  "argument2": {
                    "type": "minecraft:max",
                    "argument1": 0.0,
                    "argument2": {
                      "type": "minecraft:add",
                      "argument1": -0.05,
                      "argument2": { "type": "minecraft:noise", "noise": "lumenwilds:caverns", "xz_scale": 1.0, "y_scale": 1.0 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "surface_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": { "type": "minecraft:above_preliminary_surface" },
        "then_run": {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:stone_depth",
            "offset": 0,
            "surface_type": "floor",
            "add_surface_depth": false,
            "secondary_depth_range": 0
          },
          "then_run": {
            "type": "minecraft:sequence",
            "sequence": [
              {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "minecraft:water",
                  "offset": -1,
                  "surface_depth_multiplier": 0,
                  "add_stone_depth": false
                },
                "then_run": { "type": "minecraft:block", "result_state": { "Name": "lumenwilds:lumen_grass_block" } }
              },
              { "type": "minecraft:block", "result_state": { "Name": "lumenwilds:lumensand" } }
            ]
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": { "type": "minecraft:above_preliminary_surface" },
        "then_run": {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:stone_depth",
            "offset": 3,
            "surface_type": "floor",
            "add_surface_depth": false,
            "secondary_depth_range": 0
          },
          "then_run": { "type": "minecraft:block", "result_state": { "Name": "lumenwilds:moonloam" } }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:vertical_gradient",
          "random_name": "lumenwilds:deep_moonstone",
          "true_at_and_below": { "absolute": -16 },
          "false_at_and_above": { "absolute": 0 }
        },
        "then_run": { "type": "minecraft:block", "result_state": { "Name": "lumenwilds:deep_moonstone" } }
      }
    ]
  }
}
