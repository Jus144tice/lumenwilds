{
  "__comment": "Huge-mushroom stem multipart: the stem texture shows on each outward (true) face; the vanilla porous mushroom_block_inside shows on each inward (false) face.",
  "multipart": [
    { "when": { "north": "true" }, "apply": { "model": "lumenwilds:block/giant_glowcap_stem" } },
    { "when": { "east": "true" },  "apply": { "model": "lumenwilds:block/giant_glowcap_stem", "uvlock": true, "y": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "lumenwilds:block/giant_glowcap_stem", "uvlock": true, "y": 180 } },
    { "when": { "west": "true" },  "apply": { "model": "lumenwilds:block/giant_glowcap_stem", "uvlock": true, "y": 270 } },
    { "when": { "up": "true" },    "apply": { "model": "lumenwilds:block/giant_glowcap_stem", "uvlock": true, "x": 270 } },
    { "when": { "down": "true" },  "apply": { "model": "lumenwilds:block/giant_glowcap_stem", "uvlock": true, "x": 90 } },
    { "when": { "north": "false" }, "apply": { "model": "minecraft:block/mushroom_block_inside" } },
    { "when": { "east": "false" },  "apply": { "model": "minecraft:block/mushroom_block_inside", "y": 90 } },
    { "when": { "south": "false" }, "apply": { "model": "minecraft:block/mushroom_block_inside", "y": 180 } },
    { "when": { "west": "false" },  "apply": { "model": "minecraft:block/mushroom_block_inside", "y": 270 } },
    { "when": { "up": "false" },    "apply": { "model": "minecraft:block/mushroom_block_inside", "x": 270 } },
    { "when": { "down": "false" },  "apply": { "model": "minecraft:block/mushroom_block_inside", "x": 90 } }
  ]
}
